---
import Base from "../layouts/Base.astro";
import ProfileCard from "../components/ProfileCard.astro";
import { site, topics } from "../site.config";
import { url } from "../lib/utils";

const githubHandle = site.github.replace(/https?:\/\/github.com\//, "");
---

<Base title="关于" description={`${site.author} 的个人与网站介绍`}>
  <div class="panel">
    <h1 class="page-title">{site.title}</h1>
    <p class="lede">{site.motto}</p>
    <ProfileCard />
    <div class="prose markdown-body">
      <h2>这个网站</h2>
      <p>{site.description}</p>
      <p>目前主要记两件事：</p>
      <ul>
        <li>
          <a href={url("/hardware/")}><strong>{topics.hardware.name}</strong></a>
          — {topics.hardware.description}
        </li>
        <li>
          <a href={url("/math/")}><strong>{topics.math.name}</strong></a>
          — {topics.math.description}
        </li>
      </ul>
      <h2>找到我</h2>
      <ul>
        {site.github && (
          <li>
            <a href={site.github} rel="me">GitHub · {githubHandle}</a>
          </li>
        )}
        <li>
          <a href={url("/rss.xml")}>RSS 订阅</a>
        </li>
        {site.email && (
          <li>
            <a href={`mailto:${site.email}`}>邮箱</a>
          </li>
        )}
      </ul>
    </div>
  </div>
</Base>
