---
import { url } from "../lib/utils";

interface Props {
  tags: string[] | Map<string, number>;
  current?: string;
}

const { tags, current } = Astro.props;
const items = Array.isArray(tags)
  ? tags.map((tag) => [tag, undefined] as const)
  : [...tags.entries()];
const withCount = items.some(([, count]) => typeof count === "number");
---

<div class:list={["tags", { "tags--cloud": withCount }]}>
  {
    items.map(([tag, count]) => (
      <a
        class="tag"
        href={url(`/tags/${encodeURIComponent(tag)}/`)}
        aria-current={current === tag ? "page" : undefined}
      >
        <span class="tag__name">{tag}</span>
        {typeof count === "number" && <span class="tag__count">{count} 篇</span>}
      </a>
    ))
  }
</div>
