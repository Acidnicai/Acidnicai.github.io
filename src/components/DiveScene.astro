        </symbol>
        <symbol id="px-drip" viewBox={`0 0 ${drip.w} ${drip.h}`}>
          <Pixel art={dripArt} palette={pal} />
        </symbol>
        <symbol id="px-kelp" viewBox={`0 0 ${kelp.w} ${kelp.h}`}>
