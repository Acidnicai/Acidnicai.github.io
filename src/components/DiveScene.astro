        </symbol>
        <symbol id="px-stalk" viewBox={`0 0 ${stalk.w} ${stalk.h}`}>
          <Pixel art={stalkArt} palette={pal} />
        </symbol>
        <symbol id="px-canopy" viewBox={`0 0 ${canopy.w} ${canopy.h}`}>
          <Pixel art={canopyArt} palette={pal} />
        </symbol>
        <symbol id="px-boulder" viewBox={`0 0 ${boulder.w} ${boulder.h}`}>
          <Pixel art={boulderArt} palette={pal} />
        </symbol>
        <symbol id="px-pinnacle" viewBox={`0 0 ${pinnacle.w} ${pinnacle.h}`}>
