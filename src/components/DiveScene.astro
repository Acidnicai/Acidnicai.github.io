---
import Pixel from "./Pixel.astro";
import { sizeOf } from "../lib/pixels";
import {
  anglerArt,
  dolphinArt,
  turtleArt,
  mantaArt,
  sharkArt,
  wallArt,
  dripArt,
  archArt,
  bergArt,
  boatArt,
  cloudArt,
  columnArt,
  columnShortArt,
  coralArt,
  coralBArt,
  crystalArt,
  brinicleArt,
  crevasseArt,
  floeArt,
  algaeArt,
  icefishArt,
  sealArt,
  angelArt,
  krillArt,
  pressureArt,
  diverArt,
  fishArt,
  fishBArt,
  fishCArt,
  gullArt,
  jellyArt,
  kelpArt,
  stalkArt,
  canopyArt,
  boulderArt,
  pinnacleArt,
  urchinArt,
  otterArt,
  garibaldiArt,
  starArt,
  matArt,
  musselArt,
  brazierArt,
  colonnadeArt,
  crabArt,
  domeArt,
  mosaicArt,
  pal,
  plazaArt,
  stairsArt,
  statueArt,
  templeArt,
  sunArt,
  ventArt,
  waveArt,
  wormArt,
  shrimpArt,
  eelArt,
  basaltArt,
  ridgeArt,
} from "../lib/pixel-art";

const box = sizeOf;
const boat = box(boatArt);
const fish = box(fishArt);
const fishB = box(fishBArt);
const fishC = box(fishCArt);
const jelly = box(jellyArt);
const diver = box(diverArt);
const angler = box(anglerArt);
const dolphin = box(dolphinArt);
const turtle = box(turtleArt);
const manta = box(mantaArt);
const shark = box(sharkArt);
const wall = box(wallArt);
const drip = box(dripArt);
const kelp = box(kelpArt);
const stalk = box(stalkArt);
const canopy = box(canopyArt);
const boulder = box(boulderArt);
const pinnacle = box(pinnacleArt);
const urchin = box(urchinArt);
const otter = box(otterArt);
const garibaldi = box(garibaldiArt);
const star = box(starArt);
const coral = box(coralArt);
const coralB = box(coralBArt);
const berg = box(bergArt);
const crystal = box(crystalArt);
const brinicle = box(brinicleArt);
const crevasse = box(crevasseArt);
const floe = box(floeArt);
const algae = box(algaeArt);
const icefish = box(icefishArt);
const seal = box(sealArt);
const angel = box(angelArt);
const krill = box(krillArt);
const pressure = box(pressureArt);
const vent = box(ventArt);
const worm = box(wormArt);
const shrimp = box(shrimpArt);
const crab = box(crabArt);
const eel = box(eelArt);
const mussel = box(musselArt);
const basalt = box(basaltArt);
const ridge = box(ridgeArt);
const mat = box(matArt);
const column = box(columnArt);
const columnShort = box(columnShortArt);
const arch = box(archArt);
const mosaic = box(mosaicArt);
const temple = box(templeArt);
const colonnade = box(colonnadeArt);
const statue = box(statueArt);
const dome = box(domeArt);
const stairs = box(stairsArt);
const brazier = box(brazierArt);
const plaza = box(plazaArt);
const sun = box(sunArt);
const cloud = box(cloudArt);
const wave = box(waveArt);
const gull = box(gullArt);
---

<div class="page-bg" aria-hidden="true">
  <div class="sea">
    <div class="sea__water"></div>
    <svg class="sea__sun" viewBox={`0 0 ${sun.w} ${sun.h}`} aria-hidden="true">
      <Pixel art={sunArt} palette={pal} />
    </svg>
    <svg class="cloud cloud--1" viewBox={`0 0 ${cloud.w} ${cloud.h}`} aria-hidden="true">
      <Pixel art={cloudArt} palette={pal} />
    </svg>
    <svg class="cloud cloud--2" viewBox={`0 0 ${cloud.w} ${cloud.h}`} aria-hidden="true">
      <Pixel art={cloudArt} palette={pal} />
    </svg>
    <svg class="cloud cloud--3" viewBox={`0 0 ${cloud.w} ${cloud.h}`} aria-hidden="true">
      <Pixel art={cloudArt} palette={pal} />
    </svg>
    <svg class="gull gull--1" viewBox={`0 0 ${gull.w} ${gull.h}`} aria-hidden="true">
      <Pixel art={gullArt} palette={pal} />
    </svg>
    <svg class="gull gull--2" viewBox={`0 0 ${gull.w} ${gull.h}`} aria-hidden="true">
      <Pixel art={gullArt} palette={pal} />
    </svg>
    <div class="sea__rays"></div>
    <svg
      class="sea__wave"
      viewBox={`0 0 ${wave.w * 48} ${wave.h}`}
      preserveAspectRatio="xMidYMid slice"
      aria-hidden="true"
    >
      {
        Array.from({ length: 48 }, (_, index) => (
          <g transform={`translate(${index * wave.w} 0)`}>
            <Pixel art={waveArt} palette={pal} />
          </g>
        ))
      }
    </svg>

    <svg class="boat" viewBox={`0 0 ${boat.w} ${boat.h}`} aria-hidden="true">
      <Pixel art={boatArt} palette={pal} />
    </svg>

    <svg class="sea__sheet" width="0" height="0" aria-hidden="true">
      <defs>
        <symbol id="px-fish" viewBox={`0 0 ${fish.w} ${fish.h}`}>
          <Pixel art={fishArt} palette={pal} />
        </symbol>
        <symbol id="px-fish-b" viewBox={`0 0 ${fishB.w} ${fishB.h}`}>
          <Pixel art={fishBArt} palette={pal} />
        </symbol>
        <symbol id="px-fish-c" viewBox={`0 0 ${fishC.w} ${fishC.h}`}>
          <Pixel art={fishCArt} palette={pal} />
        </symbol>
        <symbol id="px-jelly" viewBox={`0 0 ${jelly.w} ${jelly.h}`}>
          <Pixel art={jellyArt} palette={pal} />
        </symbol>
        <symbol id="px-diver" viewBox={`0 0 ${diver.w} ${diver.h}`}>
          <Pixel art={diverArt} palette={pal} />
        </symbol>
        <symbol id="px-angler" viewBox={`0 0 ${angler.w} ${angler.h}`}>
