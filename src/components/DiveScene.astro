      <svg class="shark shark--1" viewBox={`0 0 ${shark.w} ${shark.h}`}><use href="#px-shark" width="100%" height="100%" /></svg>
      <svg class="shark shark--2" viewBox={`0 0 ${shark.w} ${shark.h}`}><use href="#px-shark" width="100%" height="100%" /></svg>
    </div>

    <div class="kelpbed">
      <svg class="canopy canopy--1" viewBox={`0 0 ${canopy.w} ${canopy.h}`}><use href="#px-canopy" width="100%" height="100%" /></svg>
      <svg class="canopy canopy--2" viewBox={`0 0 ${canopy.w} ${canopy.h}`}><use href="#px-canopy" width="100%" height="100%" /></svg>
      <svg class="kelp kelp--1" viewBox={`0 0 ${kelp.w} ${kelp.h}`}><use href="#px-kelp" width="100%" height="100%" /></svg>
      <svg class="kelp kelp--2" viewBox={`0 0 ${kelp.w} ${kelp.h}`}><use href="#px-kelp" width="100%" height="100%" /></svg>
