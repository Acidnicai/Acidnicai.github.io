    <svg class="fish fish--a fish--1" viewBox={`0 0 ${fish.w} ${fish.h}`}><use href="#px-fish" width="100%" height="100%" /></svg>
    <svg class="fish fish--b fish--2" viewBox={`0 0 ${fishB.w} ${fishB.h}`}><use href="#px-fish-b" width="100%" height="100%" /></svg>
    <svg class="fish fish--c fish--3" viewBox={`0 0 ${fishC.w} ${fishC.h}`}><use href="#px-fish-c" width="100%" height="100%" /></svg>
    <svg class="jelly jelly--1" viewBox={`0 0 ${jelly.w} ${jelly.h}`}><use href="#px-jelly" width="100%" height="100%" /></svg>
    <svg class="diver" viewBox={`0 0 ${diver.w} ${diver.h}`}><use href="#px-diver" width="100%" height="100%" /></svg>
    <svg class="fish fish--b fish--4" viewBox={`0 0 ${fishB.w} ${fishB.h}`}><use href="#px-fish-b" width="100%" height="100%" /></svg>

