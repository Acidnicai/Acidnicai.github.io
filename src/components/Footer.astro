---
import { site } from "../site.config";
import { url } from "../lib/utils";
---

<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <nav class="site-footer__links" aria-label="页脚">
      <a href={url("/about/")}>关于</a>
      <a href={url("/posts/")}>全部笔记</a>
      <a href={url("/tags/")}>标签</a>
      <a href={url("/rss.xml")}>RSS</a>
      {site.github && (
        <a href={site.github} rel="me">
          GitHub
        </a>
      )}
    </nav>
    <p class="site-footer__copy">© {new Date().getFullYear()} {site.author}</p>
  </div>
</footer>
