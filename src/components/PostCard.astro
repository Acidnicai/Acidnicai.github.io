---
import type { Post } from "../lib/posts";
import { books, topics } from "../site.config";
import { formatDateShort, url } from "../lib/utils";

interface Props {
  post: Post;
}

const { post } = Astro.props;
const topic = topics[post.data.topic];
const book = post.data.book ? books[post.data.book] : undefined;
---

<li class="post-card">
  <a href={url(`/posts/${post.id}/`)}>
    <h2>{post.data.title}</h2>
    <p class="post-list__meta">
      <time datetime={post.data.pubDate.toISOString()}>
        {formatDateShort(post.data.pubDate)}
      </time>
      <span>{book ? book.title : topic.name}</span>
      {post.data.chapter && <span>第 {post.data.chapter} 章</span>}
    </p>
    <p class="post-list__desc">{post.data.description}</p>
  </a>
</li>
