---
import "../styles/global.css";
import { site } from "../site.config";
import { url } from "../lib/utils";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  type?: "website" | "article";
  math?: boolean;
}

const {
  title,
  description = site.description,
  type = "website",
  math = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.title}` : `${site.title} · ${site.author}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const isArticle = type === "article";
---

<!doctype html>
<html lang={site.lang} class:list={[{ "is-article": isArticle }]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={site.author} />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url("favicon.svg")} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href={url("rss.xml")} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Liu+Jian+Mao+Cao&family=Noto+Sans+SC:wght@400;500;600&family=Noto+Serif+SC:wght@400;600;700&display=swap"
    />
    {math && (
      <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/katex@0.16.22/dist/katex.min.css"
      />
    )}
    <title>{pageTitle}</title>
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.dataset.theme = stored || (prefersDark ? "dark" : "light");
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">跳到正文</a>
    <div class="site-shell">
      <Header />
      <main id="content" class="wrap">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
